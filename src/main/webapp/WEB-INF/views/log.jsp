<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><c:set var="title" value="Log meal"/><%@ include file="header.jspf" %><section class="panel"><div class="section-top"><h2>Add a food</h2><p class="muted">Enter portions the way you eat them, for example 2 roti or 1 katori dal.</p></div><form action="${pageContext.request.contextPath}/log" method="post" class="food-form"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="add"><label>Meal type<select name="mealType"><option>Breakfast</option><option>Lunch</option><option>Dinner</option><option>Snack</option></select></label><label>Search food<input id="food-search" placeholder="Search foods" type="search"></label><label>Food<select id="food" name="foodId"><c:forEach var="food" items="${foods}"><option value="${food.id}" data-grams="${food.unitGrams}" data-calories="${food.nutrients.calories}" data-protein="${food.nutrients.protein}" data-unit="<c:out value='${food.unit}'/>"><c:out value="${food.name}"/></option></c:forEach></select></label><label>Quantity<input name="quantity" id="quantity" type="number" min="0.01" max="100" step="0.01" value="1" required></label><button class="primary">Add to meal</button></form><p id="conversion" class="conversion" aria-live="polite"></p></section>
<details class="panel custom-panel" ${not empty sessionScope.customValues?'open':''}>
<summary>Can't find your food? Add a custom item</summary>
<p class="muted" id="custom-help">Enter the total grams and nutrition for everything you ate, not per 100 g or per piece. For example: 2 sandwiches, 300 g, 500 calories. Quantity is recorded separately and will not multiply these totals.</p>
<form method="post" action="${pageContext.request.contextPath}/log?csrf=${sessionScope.csrf}" enctype="multipart/form-data" aria-describedby="custom-help" class="custom-form">
<input type="hidden" name="action" value="custom">
<label class="custom-name">Item name<input name="name" maxlength="100" required placeholder="e.g. Homemade sandwich" value="<c:out value='${sessionScope.customValues.name}'/>" ></label>
<label>Meal type<select name="mealType"><c:forEach var="type" items="${['Breakfast','Lunch','Dinner','Snack']}"><option ${sessionScope.customValues.mealType==type?'selected':''}>${type}</option></c:forEach></select></label>
<label>Quantity (pieces / portions)<input name="quantity" type="number" min="0.01" max="100" step="0.01" value="<c:out value='${not empty sessionScope.customValues ? sessionScope.customValues["quantity"] : "1"}'/>" required></label>
<label>Total grams<input name="grams" type="number" min="0.01" max="10000" step="0.01" value="<c:out value='${not empty sessionScope.customValues ? sessionScope.customValues["grams"] : ""}'/>" required></label>
<label>Calories (kcal)<input name="calories" type="number" min="0" max="10000" step="0.01" value="<c:out value='${not empty sessionScope.customValues ? sessionScope.customValues["calories"] : ""}'/>" required></label>
<label>Protein (g)<input name="protein" type="number" min="0" max="10000" step="0.01" value="<c:out value='${not empty sessionScope.customValues ? sessionScope.customValues["protein"] : ""}'/>" required></label>
<label>Carbs (g)<input name="carbs" type="number" min="0" max="10000" step="0.01" value="<c:out value='${not empty sessionScope.customValues ? sessionScope.customValues["carbs"] : ""}'/>" required></label>
<label>Fat (g)<input name="fat" type="number" min="0" max="10000" step="0.01" value="<c:out value='${not empty sessionScope.customValues ? sessionScope.customValues["fat"] : ""}'/>" required></label>
<label>Fiber (g)<input name="fibre" type="number" min="0" max="10000" step="0.01" value="<c:out value='${not empty sessionScope.customValues ? sessionScope.customValues["fibre"] : ""}'/>" required></label>

<div class="photo-field"><label for="custom-photo">Food photo (optional)</label><input id="custom-photo" type="file" name="photo" accept="image/jpeg,image/png" aria-describedby="photo-help"><p id="photo-help" class="muted">JPG or PNG, up to 5 MB and 12 megapixels. A photo is for reference; nutrition comes from the values you enter.</p><img id="photo-preview" alt="Selected food photo" hidden><button type="button" id="clear-photo" class="secondary small" hidden>Remove photo</button></div>
<div class="custom-submit"><button class="primary">Add custom item to meal</button><span class="muted">Then choose Save meal below.</span></div>
</form></details>
<section class="panel"><div class="section-top"><h2>Items in this meal</h2><form action="${pageContext.request.contextPath}/log" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="save"><button class="primary" ${empty draft?'disabled':''}>Save meal</button></form></div><div class="table-wrap"><table><thead><tr><th>Food</th><th>Meal</th><th>Quantity</th><th>Grams</th><th>Calories</th><th>Protein (g)</th><th>Carbs (g)</th><th>Fat (g)</th><th>Fiber (g)</th><th></th></tr></thead><tbody><c:forEach var="entry" items="${draft}" varStatus="row"><tr><td><div class="food-cell"><c:if test="${entry.hasPhoto}"><a href="${pageContext.request.contextPath}/photo?draft=${row.index}" target="_blank" rel="noopener" aria-label="View food photo"><img class="food-thumb" src="${pageContext.request.contextPath}/photo?draft=${row.index}" alt="Food photo"></a></c:if><div><c:out value="${entry.food.name}"/><c:if test="${entry.custom}"><span class="custom-tag">Custom item</span></c:if></div></div></td><td>${entry.mealType}</td><td>${entry.quantity} <c:out value="${entry.food.unit}"/></td><td><fmt:formatNumber value="${entry.grams}" maxFractionDigits="1"/></td><td><fmt:formatNumber value="${entry.total.calories}" maxFractionDigits="0"/></td><td><fmt:formatNumber value="${entry.total.protein}" maxFractionDigits="1"/></td><td><fmt:formatNumber value="${entry.total.carbs}" maxFractionDigits="1"/></td><td><fmt:formatNumber value="${entry.total.fat}" maxFractionDigits="1"/></td><td><fmt:formatNumber value="${entry.total.fibre}" maxFractionDigits="1"/></td><td><form method="post" action="${pageContext.request.contextPath}/log"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="remove"><input type="hidden" name="index" value="${row.index}"><button class="secondary small">Remove</button></form></td></tr></c:forEach><c:if test="${empty draft}"><tr><td colspan="10" class="empty">No foods added yet. Choose a food and quantity above.</td></tr></c:if></tbody><tfoot><tr><th>Total</th><td></td><td></td><td><fmt:formatNumber value="${draftGrams}" maxFractionDigits="1"/></td><c:forEach var="key" items="${['calories','protein','carbs','fat','fibre']}"><td><fmt:formatNumber value="${draftTotals[key]}" maxFractionDigits="1"/></td></c:forEach><td></td></tr></tfoot></table></div></section><%@ include file="footer.jspf" %>
