<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><c:set var="title" value="Weekly history"/><%@ include file="header.jspf" %><section class="panel"><div class="section-top"><h2>Calories per day</h2><p class="legend"><i></i> Within 10% of goal <i class="off"></i> Off target</p></div><div class="chart" role="img" aria-label="Seven days of calories; exact values in the daily totals table"><div class="goal-line">Goal ${sessionScope.user.goal.calories} kcal</div><c:forEach var="day" items="${history}"><c:set var="ratio" value="${day.value.totals.calories/sessionScope.user.goal.calories}"/><div class="bar-column"><div class="bar ${ratio>=0.9 && ratio<=1.1?'on-target':''}" style="height:${ratio*170>210?210:ratio*170}px"><span><fmt:formatNumber value="${day.value.totals.calories}" maxFractionDigits="0"/></span></div><label>${day.key==today?'Today':day.key.dayOfWeek.toString().substring(0,3)} ${day.key.dayOfMonth}</label></div></c:forEach></div></section><section class="panel"><div class="section-top"><h2>Daily totals</h2><a class="button secondary" href="${pageContext.request.contextPath}/report">Download CSV report</a></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Calories</th><th>% of goal</th><th>Protein (g)</th><th>Health score</th></tr></thead><tbody><c:forEach var="day" items="${history.descendingMap()}"><tr><td><a href="${pageContext.request.contextPath}/daily?date=${day.key}">${day.key}</a></td><td><fmt:formatNumber value="${day.value.totals.calories}" maxFractionDigits="0"/></td><td><fmt:formatNumber value="${day.value.totals.calories/sessionScope.user.goal.calories*100}" maxFractionDigits="0"/>%</td><td><fmt:formatNumber value="${day.value.totals.protein}" maxFractionDigits="1"/></td><td>${day.value.score}</td></tr></c:forEach></tbody></table></div></section><%@ include file="footer.jspf" %>
