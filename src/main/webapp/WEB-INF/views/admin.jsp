<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><c:set var="title" value="Administration"/><%@ include file="header.jspf" %><section class="panel"><div class="section-top"><h2>Background reports</h2><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="job"><button class="primary">Run report job</button></form></div><p><c:out value="${jobs.status}"/></p><p class="muted">Completed runs: ${jobs.runs} · Cache revision: ${revision} · Demo schedule: every 60 seconds. <a href="${pageContext.request.contextPath}/admin">Refresh status</a></p></section>
<section class="panel"><h2>Add or update food</h2><p class="muted">Nutrition values per 100 g. Use an existing name to update that food.</p><form class="admin-food" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="food"><label>Food name<input name="name" required maxlength="100"></label><label>Category<select name="category"><option>Prepared</option><option>Fruit</option><option>Dairy</option><option>Grain</option><option>Protein</option></select></label><c:forEach var="key" items="${['calories','protein','carbs','fat','fibre']}"><label>${key}<input name="${key}" type="number" min="0" max="10000" step="0.01" value="0" required></label></c:forEach><label>Unit<input name="unit" placeholder="katori" required maxlength="30"></label><label>Grams per unit<input name="unit_grams" type="number" min="0.01" max="10000" step="0.01" required></label><button class="primary">Save food</button></form></section>
<section class="panel"><h2>Import foods from CSV</h2><p class="muted">Required columns: name, category, calories, protein, carbs, fat, fibre, unit, unit_grams. Maximum 1 MB / 1,000 rows. All rows are validated before one transaction.</p><form action="${pageContext.request.contextPath}/admin?csrf=${sessionScope.csrf}" method="post" enctype="multipart/form-data" class="inline"><input type="hidden" name="action" value="import"><label class="sr-only" for="csv">CSV file</label><input id="csv" type="file" name="file" accept=".csv,text/csv" required><button class="primary">Import CSV</button></form></section>
<section class="panel"><h2>Food catalogue</h2><div class="table-wrap"><table><thead><tr><th>Food</th><th>Category</th><th>Portion</th><th>kcal / 100 g</th><th>Protein / 100 g</th><th></th></tr></thead><tbody><c:forEach var="food" items="${foods}"><tr><td><c:out value="${food.name}"/></td><td>${food.category}</td><td>1 <c:out value="${food.unit}"/> · ${food.unitGrams} g</td><td>${food.nutrients.calories}</td><td>${food.nutrients.protein} g</td><td><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="deleteFood"><input type="hidden" name="id" value="${food.id}"><button class="secondary small">Archive</button></form></td></tr></c:forEach></tbody></table></div></section>
<section class="panel"><h2>Users</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead><tbody><c:forEach var="person" items="${users}"><tr><td><c:out value="${person.name}"/></td><td><c:out value="${person.email}"/></td><td>${person.role}</td><td><c:if test="${not person.admin}"><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="deactivateUser"><input type="hidden" name="id" value="${person.id}"><button class="secondary small" data-confirm="Disable future logins for this user?">Deactivate</button></form></c:if></td></tr></c:forEach></tbody></table></div></section><%@ include file="footer.jspf" %>
