<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><c:set var="title" value="Dashboard"/><%@ include file="header.jspf" %><div class="metrics">
<c:forEach var="metric" items="${['Calories','Protein','Carbs','Fat']}"><c:set var="key" value="${metric.toLowerCase()}"/><c:set var="amount" value="${summary.totals[key]}"/><c:set var="goal" value="${sessionScope.user.goal[key]}"/><section class="metric"><h2>${metric}</h2><div><strong><fmt:formatNumber value="${amount}" maxFractionDigits="0"/></strong><span> / <fmt:formatNumber value="${goal}" maxFractionDigits="0"/> ${metric=='Calories'?'kcal':'g'}</span></div><progress max="${goal}" value="${amount}" aria-label="${metric} goal"></progress><p><fmt:formatNumber value="${amount/goal*100}" maxFractionDigits="0"/>% of goal · <fmt:formatNumber value="${goal-amount>0?goal-amount:0}" maxFractionDigits="0"/> ${metric=='Calories'?'kcal':'g'} left</p></section></c:forEach></div>
<div class="dashboard-bottom"><section class="panel score-panel"><h2>Health score</h2><div class="score">${summary.score}<span> / 100</span></div><strong>${summary.rating}</strong><dl><c:forEach var="rule" items="${summary.points}"><div><dt>${rule.key}</dt><dd>${rule.value}</dd></div></c:forEach></dl></section>
<section class="panel gap-panel"><div class="section-top"><h2>Gap detector</h2><a class="button small" href="${pageContext.request.contextPath}/log">Log a meal</a></div><h3>${gap.missing>0?gap.name.concat(' is your biggest gap'):'Your tracked nutrient goals are met'}</h3><p class="muted"><c:choose><c:when test="${gap.missing>0}">You are <strong><fmt:formatNumber value="${gap.missing}" maxFractionDigits="1"/> g short</strong> of your ${gap.name.toLowerCase()} goal. Try one of these foods.</c:when><c:otherwise>Keep logging meals to follow today's totals.</c:otherwise></c:choose></p>
<ol class="recommendations"><c:forEach var="food" items="${picks}"><li><div><strong><c:out value="${food.name}"/></strong><p><c:out value="${food.benefit}"/></p></div><div class="contribution"><strong>+<fmt:formatNumber value="${gap.name=='Protein'?food.nutrients.protein*food.unitGrams/100:gap.name=='Fibre'?food.nutrients.fibre*food.unitGrams/100:food.nutrients.carbs*food.unitGrams/100}" maxFractionDigits="1"/> g ${gap.name.toLowerCase()}</strong><p>1 <c:out value="${food.unit}"/> · ${food.unitGrams} g</p></div></li></c:forEach></ol><p class="note">Compared by percentage shortfall; suggestions ranked per portion.</p></section></div><%@ include file="footer.jspf" %>
