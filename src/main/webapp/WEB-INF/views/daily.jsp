<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><c:set var="title" value="Daily log"/><%@ include file="header.jspf" %><section class="panel"><div class="section-top"><h2>Meals by type</h2><form class="inline" method="get"><label class="sr-only" for="date">Date</label><input id="date" name="date" type="date" value="${summary.date}"><button class="secondary">View</button></form></div><p class="muted">${summary.date} · ${summary.entries.size()} items · <fmt:formatNumber value="${summary.totals.calories}" maxFractionDigits="0"/> of ${sessionScope.user.goal.calories} kcal</p><div class="table-wrap"><table><thead><tr><th>Food</th><th>Quantity</th><th>Grams</th><th>Calories</th><th>Protein (g)</th><th>Carbs (g)</th><th>Fat (g)</th><th>Fibre (g)</th><th></th></tr></thead><tbody>
<c:forEach var="group" items="${groups}"><tr class="group"><th>${group.key}</th><td></td><td><fmt:formatNumber value="${groupGrams[group.key]}" maxFractionDigits="1"/></td><c:forEach var="key" items="${['calories','protein','carbs','fat','fibre']}"><td><fmt:formatNumber value="${groupTotals[group.key][key]}" maxFractionDigits="1"/></td></c:forEach><td></td></tr><c:forEach var="entry" items="${group.value}"><tr><td><div class="food-cell"><c:if test="${entry.hasPhoto}"><a href="${pageContext.request.contextPath}/photo?id=${entry.id}" target="_blank" rel="noopener" aria-label="View food photo"><img class="food-thumb" src="${pageContext.request.contextPath}/photo?id=${entry.id}" alt="Food photo" loading="lazy"></a></c:if><div><c:out value="${entry.food.name}"/><c:if test="${entry.custom}"><span class="custom-tag">Custom item</span></c:if></div></div></td><td><fmt:formatNumber value="${entry.quantity}" maxFractionDigits="2"/> <c:out value="${entry.food.unit}"/></td><td><fmt:formatNumber value="${entry.grams}" maxFractionDigits="1"/></td><c:forEach var="key" items="${['calories','protein','carbs','fat','fibre']}"><td><fmt:formatNumber value="${entry.total[key]}" maxFractionDigits="1"/></td></c:forEach><td><form action="${pageContext.request.contextPath}/daily" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${entry.id}"><button class="secondary small" aria-label="Remove ${entry.food.name}">Remove</button></form></td></tr></c:forEach><c:if test="${empty group.value}"><tr><td colspan="9" class="muted">No foods logged.</td></tr></c:if></c:forEach></tbody><tfoot><tr><th>Total</th><td></td><td></td><c:forEach var="key" items="${['calories','protein','carbs','fat','fibre']}"><td><fmt:formatNumber value="${summary.totals[key]}" maxFractionDigits="1"/></td></c:forEach><td></td></tr></tfoot></table></div></section><%@ include file="footer.jspf" %>
