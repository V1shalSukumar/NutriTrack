<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Login · NutriTrack</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body class="login-page"><section class="login-card"><h1>NutriTrack</h1><p class="intro">Log meals in everyday portions and see where your nutrition falls short.</p><c:if test="${not empty error}"><div class="notice" role="alert"><c:out value="${error}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/login"><input type="hidden" name="csrf" value="${sessionScope.csrf}">
<label>Email<input name="email" type="email" autocomplete="username" required value="user@nutritrack.com"></label><label>Password<input name="password" type="password" autocomplete="current-password" required></label>
<fieldset><legend>Login as</legend><div class="role-toggle"><label><input type="radio" name="role" value="USER" checked><span>User</span></label><label><input type="radio" name="role" value="ADMIN"><span>Admin</span></label></div></fieldset><button class="primary full">Login</button></form>
<p class="demo">Demo accounts:<br>User: user@nutritrack.com / user123<br>Admin: admin@nutritrack.com / admin123</p></section></body></html>
